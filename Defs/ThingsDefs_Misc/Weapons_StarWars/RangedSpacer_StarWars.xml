<Defs>


  <!-- slug type bullet can and should be reused for slugthrowers just needs fine tuning for stats
  (<defaultProjectile>Bullet_Slug</defaultProjectile>)-->
  <ThingDef ParentName="BaseBullet">
    <defName>Bullet_Slug</defName>
    <label>Slug</label>
    <graphicData>
      <texPath>Things/Projectile/Slug</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <projectile>
      <damageDef>Bullet</damageDef>
      <damageAmountBase>22</damageAmountBase>
      <stoppingPower>2.0</stoppingPower>
      <armorPenetrationBase>0.25</armorPenetrationBase>
      <speed>90</speed>
    </projectile>
  </ThingDef>

  <ThingDef ParentName="BaseHumanMakeableGun" Name="Gun_SlugThrowerPistol">
    <defName>AandA_Gun_SlugThrowerPistol</defName>
    <label>SlugThrower Pistol</label>
    <description>A smaller pistol style variant of a standard SlugThrower. mostly used in places
      where blasters were
      uncommon.</description>
    <techLevel>Spacer</techLevel>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponRanged_StarWars/SlugThrowerPistol</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <soundInteract>Interact_SlugThrowerPistol</soundInteract>
    <statBases>
      <WorkToMake>22500</WorkToMake>
      <Mass>2.4</Mass>
      <AccuracyTouch>0.82</AccuracyTouch>
      <AccuracyShort>0.77</AccuracyShort>
      <AccuracyMedium>0.65</AccuracyMedium>
      <AccuracyLong>0.55</AccuracyLong>
      <RangedWeapon_Cooldown>1.40</RangedWeapon_Cooldown>
    </statBases>
    <weaponTags>
      <li>SpacerGun</li>
    </weaponTags>
    <weaponClasses>
      <li>RangedLight</li>
    </weaponClasses>
    <thingSetMakerTags>
      <li>RewardStandardQualitySuper</li>
    </thingSetMakerTags>
    <tradeTags>
      <li>WeaponRanged</li>
    </tradeTags>
    <costList>
      <Plasteel>30</Plasteel>
      <ComponentSpacer>2</ComponentSpacer>
    </costList>
    <recipeMaker>
      <researchPrerequisite>SlugThrowers</researchPrerequisite>
      <skillRequirements>
        <Crafting>8</Crafting>
      </skillRequirements>
      <recipeUsers Inherit="False">
        <li>FabricationBench</li>
      </recipeUsers>
      <displayPriority>401</displayPriority>
    </recipeMaker>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Bullet_Slug</defaultProjectile>
        <warmupTime>0.2</warmupTime>
        <range>27.9</range>
        <soundCast>Shot_SlugThrowerPistol</soundCast>
        <soundCastTail>GunTail_Light</soundCastTail>
        <muzzleFlashScale>6</muzzleFlashScale>
      </li>
    </verbs>
    <tools>
      <li>
        <label>stock</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>9</power>
        <cooldownTime>1.7</cooldownTime>
      </li>
      <li>
        <label>barrel</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>9</power>
        <cooldownTime>1.7</cooldownTime>
      </li>
    </tools>
  </ThingDef>

